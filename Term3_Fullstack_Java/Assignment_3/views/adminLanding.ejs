<%- include('partials/header', { title: "Admin Dashboard" }) %>
    <h1>Welcome <%= user.username %> (Admin)</h1>
    
    <h2>Regular Users</h2>

    <div class="main-content">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>RSVP'd?</th>
                    <th>RSVP Time</th>
                </tr>
            </thead>

            <tbody>
                <% users.filter(user => user.role === "user").forEach(user => { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.username %></td>
                        <td><%= user.email %></td>
                        <td><%= user.hasRSVPed ? 'Yes' : 'No' %></td>
                        <td><%= user.rsvpTime ? user.rsvpTime.toLocaleString() : 'N/A' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <a href="/logout">Logout</a>

<%- include('partials/footer') %>